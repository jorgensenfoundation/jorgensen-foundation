<style>
  :root{ --ink:#302C2E; --cream:#f4efe4; --hairline:#DEDCD5; --stone:#53534C; }
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:Helvetica,Arial,sans-serif;background:#faf9f7;color:var(--ink);-webkit-font-smoothing:antialiased}
  .wrap{max-width:1000px;margin:0 auto;padding:4rem 2rem 6rem}

<script>
  // Favicon stress test: rasterise each symbol at its REAL favicon size (16/24/32),
  // then magnify 10x with nearest-neighbour so the actual pixels are visible.
  // Colors are baked in (canvas can't read currentColor through <use>).
  var INK = '#302C2E', CREAM = '#f4efe4';
  var SYMS = {
    final: '<g fill="none" stroke="COLOR" stroke-width="2.4" stroke-linecap="round"><line x1="32" y1="28.5" x2="32" y2="23.5"/><line x1="25.5" y1="39.8" x2="21.2" y2="42.3"/><line x1="38.5" y1="39.8" x2="42.8" y2="42.3"/></g><circle cx="32" cy="17" r="4" fill="COLOR"/><circle cx="15.5" cy="45.5" r="4" fill="COLOR"/><circle cx="48.5" cy="45.5" r="4" fill="COLOR"/><circle cx="32" cy="36" r="5" fill="COLOR"/>',
    fav: '<g fill="none" stroke="COLOR" stroke-width="3.2" stroke-linecap="round"><line x1="32" y1="28" x2="32" y2="24"/><line x1="25.07" y1="40" x2="21.61" y2="42"/><line x1="38.93" y1="40" x2="42.39" y2="42"/></g><circle cx="32" cy="17" r="4.5" fill="COLOR"/><circle cx="15.5" cy="45.5" r="4.5" fill="COLOR"/><circle cx="48.5" cy="45.5" r="4.5" fill="COLOR"/><circle cx="32" cy="36" r="5.5" fill="COLOR"/>'
  };
  function svgURL(sym, color, size){
    var inner = SYMS[sym].replace(/COLOR/g, color);
    var s = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="' + size + '" height="' + size + '">' + inner + '</svg>';
    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(s);
  }
  document.querySelectorAll('canvas[data-sym]').forEach(function(cv){
    var sym = cv.dataset.sym, size = +cv.dataset.size, mode = cv.dataset.mode || 'light';
    var Z = 10;
    cv.width = size * Z; cv.height = size * Z;
    var ctx = cv.getContext('2d');
    if (mode === 'dark') { ctx.fillStyle = INK; ctx.fillRect(0, 0, cv.width, cv.height); }
    var small = document.createElement('canvas'); small.width = size; small.height = size;
    var sctx = small.getContext('2d');             // antialiased raster at favicon size (like a real favicon)
    var img = new Image();
    img.onload = function(){
      sctx.clearRect(0, 0, size, size);
      sctx.drawImage(img, 0, 0, size, size);
      ctx.imageSmoothingEnabled = false;           // blocky magnify = honest pixel view
      ctx.drawImage(small, 0, 0, cv.width, cv.height);
    };
    img.src = svgURL(sym, mode === 'dark' ? CREAM : INK, size);
  });
</script>

<script>
  // Letter-mark comparison. Every mark is drawn on a 64-unit grid via a per-mark
  // function so the favicon (rasterise-at-size then magnify) is honest and matches
  // the large display exactly. Serif marks use the loaded Cormorant web font.
  (async function(){
    var INK = '#302C2E', CREAM = '#f4efe4';
    try { await document.fonts.load("500 48px 'Cormorant Garamond'"); await document.fonts.ready; } catch(e){}

    function pen(ctx, c, w){ ctx.strokeStyle = c; ctx.lineWidth = w; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; }
    function serif(ctx, c, px){ ctx.fillStyle = c; ctx.font = "500 " + px + "px 'Cormorant Garamond', Georgia, serif"; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; }

    var DFINAL = '<g fill="none" stroke="COLOR" stroke-width="2.4" stroke-linecap="round"><line x1="32" y1="28.5" x2="32" y2="23.5"/><line x1="25.5" y1="39.8" x2="21.2" y2="42.3"/><line x1="38.5" y1="39.8" x2="42.8" y2="42.3"/></g><circle cx="32" cy="17" r="4" fill="COLOR"/><circle cx="15.5" cy="45.5" r="4" fill="COLOR"/><circle cx="48.5" cy="45.5" r="4" fill="COLOR"/><circle cx="32" cy="36" r="5" fill="COLOR"/>';

    var DRAW = {
      J1: function(ctx, c){ serif(ctx, c, 56); ctx.fillText('J', 33, 33); },
      J2: function(ctx, c){ pen(ctx, c, 5); ctx.beginPath();
        ctx.moveTo(33,16); ctx.lineTo(47,16);
        ctx.moveTo(40,16); ctx.lineTo(40,38);
        ctx.moveTo(40,38); ctx.quadraticCurveTo(40,48,31,48); ctx.quadraticCurveTo(23,48,23,41);
        ctx.stroke(); },
      J3: function(ctx, c){ pen(ctx, c, 3.4); ctx.beginPath(); ctx.arc(32,32,25,0,6.2832); ctx.stroke();
        serif(ctx, c, 34); ctx.fillText('J', 33, 33); },
      J4: function(ctx, c){ pen(ctx, c, 3.4); ctx.strokeRect(8,8,48,48);
        serif(ctx, c, 34); ctx.fillText('J', 33, 33); },
      JF1: function(ctx, c){ serif(ctx, c, 46); ctx.fillText('J', 23, 33); ctx.fillText('F', 43, 33); },
      JF2: function(ctx, c){ pen(ctx, c, 5); ctx.beginPath();
        ctx.moveTo(29,15); ctx.lineTo(29,44);
        ctx.moveTo(29,15); ctx.lineTo(46,15);
        ctx.moveTo(29,28); ctx.lineTo(42,28);
        ctx.moveTo(29,44); ctx.quadraticCurveTo(29,50,22,50); ctx.quadraticCurveTo(16,50,16,44);
        ctx.stroke(); },
      JF3: function(ctx, c){ pen(ctx, c, 3.4); ctx.beginPath(); ctx.arc(32,32,26,0,6.2832); ctx.stroke();
        ctx.save(); ctx.translate(32,33); ctx.scale(0.6,0.6); ctx.translate(-31,-32);
        pen(ctx, c, 6); ctx.beginPath();
        ctx.moveTo(29,15); ctx.lineTo(29,44);
        ctx.moveTo(29,15); ctx.lineTo(46,15);
        ctx.moveTo(29,28); ctx.lineTo(42,28);
        ctx.moveTo(29,44); ctx.quadraticCurveTo(29,50,22,50); ctx.quadraticCurveTo(16,50,16,44);
        ctx.stroke(); ctx.restore(); },
      JS1: function(ctx, c){ pen(ctx, c, 5); ctx.beginPath();
        ctx.moveTo(40,23); ctx.lineTo(40,40); ctx.quadraticCurveTo(40,48,31,48); ctx.quadraticCurveTo(24,48,24,42);
        ctx.stroke();
        ctx.fillStyle = c; ctx.beginPath(); ctx.arc(40,15,4.5,0,6.2832); ctx.fill(); },
      JS2: function(ctx, c){ pen(ctx, c, 4); ctx.beginPath();
        ctx.moveTo(40,21); ctx.lineTo(40,39); ctx.quadraticCurveTo(40,47,32,47); ctx.quadraticCurveTo(26,47,26,44);
        ctx.stroke();
        ctx.fillStyle = c; ctx.beginPath(); ctx.arc(40,15,4,0,6.2832); ctx.fill();
        ctx.beginPath(); ctx.arc(25,41,4,0,6.2832); ctx.fill(); }
    };

    function svgURL(inner, color, size){
      var s = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="' + size + '" height="' + size + '">' + inner.replace(/COLOR/g, color) + '</svg>';
      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(s);
    }

    document.querySelectorAll('canvas[data-mark]').forEach(function(cv){
      var id = cv.dataset.mark, size = +cv.dataset.size, mode = cv.dataset.mode || 'light', mag = +(cv.dataset.mag || 1);
      var color = mode === 'dark' ? CREAM : INK;
      var disp = size * mag;
      cv.width = disp; cv.height = disp;
      var ctx = cv.getContext('2d');
      function bg(c){ if (mode === 'dark') { c.fillStyle = INK; c.fillRect(0, 0, c.canvas.width, c.canvas.height); } }

      if (id === 'Dfinal') {
        var img = new Image();
        img.onload = function(){
          if (mag > 1) {
            var sm = document.createElement('canvas'); sm.width = size; sm.height = size; var sc = sm.getContext('2d');
            bg(sc); sc.drawImage(img, 0, 0, size, size);
            ctx.imageSmoothingEnabled = false; ctx.drawImage(sm, 0, 0, disp, disp);
          } else { bg(ctx); ctx.drawImage(img, 0, 0, disp, disp); }
        };
        img.src = svgURL(DFINAL, color, size);
        return;
      }

      var fn = DRAW[id]; if (!fn) return;
      if (mag > 1) {
        var sm = document.createElement('canvas'); sm.width = size; sm.height = size; var sc = sm.getContext('2d');
        bg(sc); sc.save(); sc.scale(size / 64, size / 64); fn(sc, color); sc.restore();
        ctx.imageSmoothingEnabled = false; ctx.drawImage(sm, 0, 0, disp, disp);
      } else {
        bg(ctx); ctx.save(); ctx.scale(disp / 64, disp / 64); fn(ctx, color); ctx.restore();
      }
    });
  })();
</script>

<script>
  // Interlocked serif "JF" monogram — built from filled vector paths so we control
  // the Didone thick/thin. A shared central stem; F arms on the right; J swash tail
  // curling lower-left. Same source markup feeds the large inline SVGs and the
  // canvas favicon stress test. viewBox 0 0 100 100, COLOR is swapped per context.
  (function(){
    var INK = '#302C2E', CREAM = '#f4efe4';
    function n(v){ return Math.round(v * 100) / 100; }
    function rect(x, y, w, h){ return w <= 0 || h <= 0 ? '' : '<rect x="' + n(x) + '" y="' + n(y) + '" width="' + n(w) + '" height="' + n(h) + '" fill="COLOR"/>'; }
    function circ(cx, cy, r){ return '<circle cx="' + n(cx) + '" cy="' + n(cy) + '" r="' + n(r) + '" fill="COLOR"/>'; }

    function swash(p){
      var hw = p.W / 2, cx = p.cx, sb = p.stemBottom, bx = p.bx, by = p.by, tx = p.tx, ty = p.ty, th = p.th;
      var xR = cx + hw, xL = cx - hw, mid = sb + (by - sb) * 0.5;
      var d = 'M' + n(xR) + ',' + n(sb)
        + 'C' + n(xR + 2) + ',' + n(mid) + ' ' + n(bx + 13) + ',' + n(by) + ' ' + n(bx) + ',' + n(by)
        + 'C' + n(bx - 13) + ',' + n(by) + ' ' + n(tx + 3) + ',' + n(ty + 6) + ' ' + n(tx) + ',' + n(ty)
        + 'C' + n(tx + 4) + ',' + n(ty + 1) + ' ' + n(bx - 7) + ',' + n(by - th) + ' ' + n(bx) + ',' + n(by - th)
        + 'C' + n(bx + 13) + ',' + n(by - th) + ' ' + n(xL - 2) + ',' + n(mid) + ' ' + n(xL) + ',' + n(sb)
        + 'Z';
      return '<path d="' + d + '" fill="COLOR"/>';
    }

    function genMono(p){
      var hw = p.W / 2, cx = p.cx, s = '';
      s += rect(cx - hw, p.topY, p.W, p.stemBottom - p.topY);                         // stem
      s += rect(cx - hw - p.serifExt, p.topY, p.W + p.serifExt, p.serifH);            // top serif (flat, extends left)
      s += rect(cx, p.topArmY, p.topArmRight - cx, p.armH);                            // F top arm
      s += rect(p.topArmRight - p.armEnd, p.topArmY - 1, p.armEnd, p.armH + p.armTick);// top arm end serif
      s += rect(cx, p.midArmY, p.midArmRight - cx, p.armH);                            // F middle arm
      s += rect(p.midArmRight - p.armEnd, p.midArmY - 1, p.armEnd, p.armH + p.armTick);// middle arm end serif
      s += swash(p);                                                                   // J swash
      if (p.ballR) s += circ(p.tx, p.ty, p.ballR);                                     // tail ball terminal
      return s;
    }

    var base = { cx:48, W:13, topY:16, stemBottom:70, midArmY:44, armH:5, serifExt:8, serifH:4, armEnd:4, armTick:4,
                 topArmY:16, topArmRight:86, midArmRight:78, bx:35, by:92, tx:14, ty:80, th:11, ballR:0 };
    function mk(over){ var o = {}; for (var k in base) o[k] = base[k]; for (var k2 in over) o[k2] = over[k2]; return o; }

    var P = {
      V1: mk({}),
      V2: mk({ bx:33, by:95, tx:8, ty:84, th:12, ballR:3.5 }),
      V3: mk({ bx:40, by:89, tx:26, ty:79, th:10, topArmRight:82, midArmRight:74 }),
      V4: mk({ W:16, armH:3.4, serifH:2.8, armEnd:3.2, th:13, bx:35, by:94, tx:13, ty:81 }),
      V5: mk({ cx:45, topArmRight:92, midArmRight:86, bx:34, by:92, tx:13, ty:80 }),
      V6: mk({ serifExt:9, armH:4.6, topArmRight:88, midArmRight:80, bx:34, by:93, tx:11, ty:83, th:11.5, ballR:3 })
    };

    var MONO = {};
    for (var id in P) MONO[id] = genMono(P[id]);

    // NOTE: the large V1–V6 monograms are now STATIC inline SVG in the HTML (no
    // svg.innerHTML injection — that silently failed on older Safari/WebKit). MONO[]
    // is retained only to drive the favicon canvas stress test below (data-URL method).

    function svgURL(inner, color, size){
      var s = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="' + size + '" height="' + size + '">' + inner.replace(/COLOR/g, color) + '</svg>';
      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(s);
    }
    document.querySelectorAll('canvas[data-mono-fav]').forEach(function(cv){
      var id = cv.dataset.monoFav, size = +cv.dataset.size, mode = cv.dataset.mode || 'light', mag = +(cv.dataset.mag || 1);
      var color = mode === 'dark' ? CREAM : INK, disp = size * mag;
      cv.width = disp; cv.height = disp;
      var ctx = cv.getContext('2d');
      var img = new Image();
      img.onload = function(){
        var sm = document.createElement('canvas'); sm.width = size; sm.height = size; var sc = sm.getContext('2d');
        if (mode === 'dark') { sc.fillStyle = INK; sc.fillRect(0, 0, size, size); }
        sc.drawImage(img, 0, 0, size, size);
        ctx.imageSmoothingEnabled = false; ctx.drawImage(sm, 0, 0, disp, disp);
      };
      img.src = svgURL(MONO[id], color, size);
    });
  })();
</script>
</body>
</html>

  .lockup{display:flex;align-items:center;gap:1.25rem}
  .sym{color:var(--ink);flex-shrink:0}
  .wordmark{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:1.55rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--ink);line-height:1;white-space:nowrap}

  .row{display:flex;gap:2rem;margin-top:2rem;flex-wrap:wrap}
  .panel{flex:1;min-width:280px;border:1px solid var(--hairline);padding:1.5rem 1.75rem}
  .panel-label{font-size:0.55rem;letter-spacing:0.22em;text-transform:uppercase;color:#aaa;margin-bottom:1.25rem;display:block}
  .sizes{display:flex;align-items:flex-end;gap:2rem}
  .szcell{display:flex;flex-direction:column;align-items:center;gap:0.5rem}
  .szlab{font-size:0.55rem;color:#bbb;letter-spacing:0.1em}

  .panel.dark{background:var(--ink);border-color:var(--ink)}
  .panel.dark .panel-label{color:rgba(244,239,228,0.45)}
  .panel.dark .sym{color:var(--cream)}
  .panel.dark .wordmark{color:var(--cream);font-size:0.92rem;letter-spacing:0.26em}

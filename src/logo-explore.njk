  .favcell{display:flex;flex-direction:column;align-items:center;gap:0.5rem}
  .favcell canvas{border:1px solid var(--hairline);image-rendering:pixelated;display:block}

  /* Wordmark-pairing exploration */
  .pair-note{font-size:0.62rem;color:var(--stone);line-height:1.7;margin:0.4rem 0 0}
  .lk-row{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.5rem}
  .lk-stage{border:1px solid var(--hairline);padding:3.5rem 2.5rem;display:flex;align-items:center;justify-content:center;min-height:220px;background:#fff}
  .lk-stage.dark{background:var(--ink);border-color:var(--ink)}
  .lk-stage.dark .lk-word{color:var(--cream)}
  .lk-stage.dark .sym{color:var(--cream)}
  .lk{display:flex}
  .lk-h{flex-direction:row;align-items:center}

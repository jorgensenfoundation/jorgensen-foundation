---
layout: marketing.njk
mainCss: /css/components.css
pageCss: /css/brand.css
permalink: /brand/index.html
title: Brand & Logo — Jorgensen Foundation
description: Download the Jorgensen Foundation logo for posters, presentations, and publications.
---

<!-- DARK HERO BAND — keeps the transparent .nav--hero nav legible -->
<section class="brand-hero">
  <div class="brand-hero-bg"></div>
  <div class="brand-hero-inner">
    <span class="brand-eyebrow">Brand Assets</span>
    <h1 class="brand-h1">Brand &amp; Logo</h1>
    <p class="brand-sub">Download the Jorgensen Foundation logo for posters, presentations, and publications. Please don't alter the proportions or colors.</p>
  </div>
</section>

<div class="brand-body">

  <div class="brand-zip">
    <a class="btn btn--primary" href="/img/brand/jorgensen-brand-pack.zip" download>Download everything (.zip)</a>
  </div>

  <!-- LOGO: horizontal (symbol + name) -->
  <section class="brand-group">
    <h2 class="brand-group-h">Logo — Horizontal</h2>
    <div class="brand-swatches">
      <div class="brand-swatch light lock"><img src="/img/brand/jf-lockup-midnight.svg" alt="Jorgensen Foundation logo in Midnight"></div>
      <div class="brand-swatch dark lock"><img src="/img/brand/jf-lockup-cream.svg" alt="Jorgensen Foundation logo in Cream"></div>
    </div>
    <div class="brand-dl">
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-midnight.svg" download>SVG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-cream.svg" download>SVG · Cream</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-midnight-2048.png" download>PNG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-cream-2048.png" download>PNG · Cream</a>
    </div>
  </section>

  <!-- LOGO: stacked (symbol over name) -->
  <section class="brand-group">
    <h2 class="brand-group-h">Logo — Stacked</h2>
    <div class="brand-swatches">
      <div class="brand-swatch light lock-stacked"><img src="/img/brand/jf-lockup-stacked-midnight.svg" alt="Jorgensen Foundation stacked logo in Midnight"></div>
      <div class="brand-swatch dark lock-stacked"><img src="/img/brand/jf-lockup-stacked-cream.svg" alt="Jorgensen Foundation stacked logo in Cream"></div>
    </div>
    <div class="brand-dl">
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-midnight.svg" download>SVG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-cream.svg" download>SVG · Cream</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-midnight-1024.png" download>PNG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-cream-1024.png" download>PNG · Cream</a>
    </div>
  </section>

  <!-- LOGO: stacked, centered -->
  <section class="brand-group">
    <h2 class="brand-group-h">Logo — Stacked (Centered)</h2>
    <div class="brand-swatches">
      <div class="brand-swatch light lock-stacked"><img src="/img/brand/jf-lockup-stacked-centered-midnight.svg" alt="Jorgensen Foundation centered stacked logo in Midnight"></div>
      <div class="brand-swatch dark lock-stacked"><img src="/img/brand/jf-lockup-stacked-centered-cream.svg" alt="Jorgensen Foundation centered stacked logo in Cream"></div>
    </div>
    <div class="brand-dl">
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-centered-midnight.svg" download>SVG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-centered-cream.svg" download>SVG · Cream</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-centered-midnight-1024.png" download>PNG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-lockup-stacked-centered-cream-1024.png" download>PNG · Cream</a>
    </div>
  </section>

  <section class="brand-group">
    <h2 class="brand-group-h">Monogram</h2>
    <div class="brand-swatches">
      <div class="brand-swatch light mono"><img src="/img/brand/jf-monogram-midnight.svg" alt="Jorgensen Foundation JF monogram in Midnight"></div>
      <div class="brand-swatch dark mono"><img src="/img/brand/jf-monogram-cream.svg" alt="Jorgensen Foundation JF monogram in Cream"></div>
    </div>
    <div class="brand-dl">
      <a class="btn btn--secondary" href="/img/brand/jf-monogram-midnight.svg" download>SVG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-monogram-cream.svg" download>SVG · Cream</a>
      <a class="btn btn--secondary" href="/img/brand/jf-monogram-midnight-1024.png" download>PNG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-monogram-cream-1024.png" download>PNG · Cream</a>
    </div>
  </section>

  <section class="brand-group">
    <h2 class="brand-group-h">Monogram — Seal</h2>
    <div class="brand-swatches">
      <div class="brand-swatch light seal"><img src="/img/brand/jf-seal-midnight.svg" alt="Jorgensen Foundation JF seal with Est. 2026 in Midnight"></div>
      <div class="brand-swatch dark seal"><img src="/img/brand/jf-seal-cream.svg" alt="Jorgensen Foundation JF seal with Est. 2026 in Cream"></div>
    </div>
    <div class="brand-dl">
      <a class="btn btn--secondary" href="/img/brand/jf-seal-midnight.svg" download>SVG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-seal-cream.svg" download>SVG · Cream</a>
      <a class="btn btn--secondary" href="/img/brand/jf-seal-midnight-1024.png" download>PNG · Midnight</a>
      <a class="btn btn--secondary" href="/img/brand/jf-seal-cream-1024.png" download>PNG · Cream</a>
    </div>
  </section>

  <!-- PROGRAM LOGOS -->
  <section class="brand-group">
    <h2 class="brand-group-h">Program Logos</h2>
    {% set programs = [
      { slug: "boss", label: "BOSS" },
      { slug: "mcpro", label: "MCPRO" },
      { slug: "bomb", label: "BOMB" },
      { slug: "fep", label: "FEP" },
      { slug: "opls", label: "OPLS" },
      { slug: "visualisation", label: "Visualisation" }
    ] %}
    <div class="brand-swatches brand-progs">
      {% for p in programs %}
      <div class="brand-prog">
        <div class="brand-swatch light prog"><img src="/img/brand/programs/{{ p.slug }}-midnight.svg" alt="{{ p.label }} program mark"></div>
        <div class="brand-dl brand-dl--prog">
          <a class="btn btn--secondary" href="/img/brand/programs/{{ p.slug }}-midnight.svg" download>SVG · Midnight</a>
          <a class="btn btn--secondary" href="/img/brand/programs/{{ p.slug }}-cream.svg" download>SVG · Cream</a>
          <a class="btn btn--secondary" href="/img/brand/programs/{{ p.slug }}-midnight-1024.png" download>PNG · Midnight</a>
          <a class="btn btn--secondary" href="/img/brand/programs/{{ p.slug }}-cream-1024.png" download>PNG · Cream</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- USAGE -->
  <div class="brand-note">
    <p><b>Usage.</b> Use <span class="brand-sw mid"></span><b>Midnight #302C2E</b> on light backgrounds and <span class="brand-sw cream"></span><b>Cream #f4efe4</b> on dark backgrounds. Keep clear space around the mark, and please don't recolor, distort, or rotate it. PNGs are provided at 512, 1024, and 2048&nbsp;px inside the .zip.</p>
  </div>

</div>

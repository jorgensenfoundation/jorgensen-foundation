---
layout: marketing.njk
comingSoonGate: false
mainCss: /css/components.css
pageCss: /css/dashboard.css
permalink: /dashboard/index.html
title: Dashboard — Jorgensen Foundation
description: Your Jorgensen Foundation account dashboard.
---

<!-- DARK HERO BAND — gives the transparent .nav--hero nav a dark backdrop (legible cream) -->
<section class="dash-hero">
  <div class="dash-hero-bg"></div>
  <div class="dash-hero-inner">
    <span class="dash-hero-tag">Your Account</span>
    <h1 class="dash-hero-h1">Dashboard</h1>
    <p class="dash-hero-sub">Welcome back to the Jorgensen Foundation.</p>
  </div>
</section>

<!-- SIGN-IN GATE — shown by dashboard.js when logged out (sign in via the account menu, top right) -->
<section class="dash-gate" id="dash-gate" hidden>
  <div class="dash-gate-card">
    <span class="dash-gate-label">Account Required</span>
    <h2 class="dash-gate-title">Please sign in</h2>
    <p class="dash-gate-body">Use the account icon at the top right to sign in, then your dashboard will appear here.</p>
  </div>
</section>

<!-- DASHBOARD CONTENT — revealed by dashboard.js when logged in -->
<div class="dashboard-content" id="dashboard-content" hidden>
  <div class="dashboard-header">
    <div class="dashboard-welcome">Good to see you,<br><em id="dash-name">—</em></div>
    <div class="dashboard-meta">
      <div class="dashboard-email" id="dash-email"></div>
      <span class="dashboard-type" id="dash-type"></span>
    </div>
  </div>

  <!-- Activate prompt — shown by dashboard.js only when subscription_status !== 'active' -->
  <div class="activate-banner" id="activate-banner" hidden>
    <div class="activate-banner-text">
      <span class="activate-banner-title">Activate your subscription</span>
      <p class="activate-banner-body">Subscribe to unlock the computational-chemistry programs below.</p>
    </div>
    <button class="choice-btn choice-btn-primary" type="button" onclick="window.location.href='/login'">Activate Subscription</button>
  </div>

  <!-- ACTIONS ROW — shown to everyone (grants are free for all) -->
  <div class="dash-actions">
    <p class="dash-actions-note">Applying for a student travel grant is always free — no subscription required.</p>
    <div class="dash-actions-btns">
      <a class="choice-btn choice-btn-primary" href="/grants#apply">Apply for a Grant</a>
      <a class="choice-btn choice-btn-secondary" id="choice-review" href="/review" hidden>Review Applications</a>
    </div>
  </div>

  <span class="programs-label" id="your-programs">Your Programs</span>
  <div class="programs-grid">

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/boss.njk" %}</div>
        <div class="prog-name">BOSS</div>
        <div class="prog-tagline">Biochemical &amp; Organic Simulation System</div>
        <p class="prog-short">Monte Carlo statistical mechanics and molecular mechanics for organic and biological molecules in solution.</p>
        <div class="prog-actions">
          <a href="/boss" class="prog-launch">Launch BOSS →</a>
          <a href="/boss#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/mcpro.njk" %}</div>
        <div class="prog-name">MCPRO</div>
        <div class="prog-tagline">Monte Carlo for Proteins</div>
        <p class="prog-short">Monte Carlo simulations of peptides, proteins, and nucleic acids in solution with full solvent treatment.</p>
        <div class="prog-actions">
          <a href="/mcpro" class="prog-launch">Launch MCPRO →</a>
          <a href="/mcpro#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/bomb.njk" %}</div>
        <div class="prog-name">BOMB</div>
        <div class="prog-tagline">Biochemical &amp; Organic Model Builder</div>
        <p class="prog-short">Combinatorial library growth inside protein binding sites for structure-based drug discovery and lead optimisation.</p>
        <div class="prog-actions">
          <a href="/bomb" class="prog-launch">Launch BOMB →</a>
          <a href="/bomb#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/fep.njk" %}</div>
        <div class="prog-name">FEP</div>
        <div class="prog-tagline">Free Energy Perturbation</div>
        <p class="prog-short">Rigorous free energy calculations for binding affinities, solvation, and chemical transformations.</p>
        <div class="prog-actions">
          <a href="/fep" class="prog-launch">Launch FEP →</a>
          <a href="/fep#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/opls.njk" %}</div>
        <div class="prog-name">OPLS Force Fields</div>
        <div class="prog-tagline">Optimised Potentials for Liquid Simulations</div>
        <p class="prog-short">Industry-standard force fields covering organic molecules, proteins, nucleic acids, and lipids.</p>
        <div class="prog-actions">
          <a href="/opls" class="prog-launch">Launch OPLS →</a>
          <a href="/opls#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="prog-card">
      <div class="prog-body">
        <div class="prog-icon">{% include "symbols/visualisation.njk" %}</div>
        <div class="prog-name">Visualisation Suite</div>
        <div class="prog-tagline">3D Molecular Rendering</div>
        <p class="prog-short">Browser-based interactive 3D rendering of all simulation outputs — no installation required.</p>
        <div class="prog-actions">
          <a href="/visualisation" class="prog-launch">Launch Visualiser →</a>
          <a href="/visualisation#technical" class="prog-learn">Learn more →</a>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="/js/dashboard.js"></script>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homepage hero directions — Jorgensen Foundation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
<style>
  :root{ --ink:#302C2E; --body:#53534C; --surface:#DEDCD5; --ground:#ffffff; --cream:#f4efe4;
         --hero-overlay:rgba(9,10,13,.82); }
  *{box-sizing:border-box;margin:0}
  body{font-family:Helvetica,Arial,sans-serif;background:var(--ink);color:var(--cream)}
  .serif{font-family:'Cormorant Garamond',serif}
  .tag{position:absolute;top:1rem;left:1.4rem;z-index:5;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:#9a958e;font-weight:700;background:rgba(0,0,0,.35);padding:.35rem .7rem}
  .hero{position:relative;height:100vh;min-height:600px;overflow:hidden;background:var(--ink);border-bottom:2px solid #000}
  .viewer{position:absolute;inset:0;z-index:0}
  .viewer canvas{display:block}
  .grad{position:absolute;inset:0;z-index:1;pointer-events:none}
  .eyebrow{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:.95rem;letter-spacing:.34em;text-transform:uppercase;color:var(--cream)}
  .display{font-family:'Cormorant Garamond',serif;font-weight:300;color:var(--cream);font-size:clamp(3.5rem,7.5vw,6.5rem);line-height:1.02}
  .display em{font-style:italic}
  .btn{display:inline-block;font-family:Helvetica,Arial,sans-serif;font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--cream);border:1px solid color-mix(in srgb,var(--cream) 55%,transparent);padding:.8rem 1.6rem;text-decoration:none}
  .mono{font-family:'Cormorant Garamond',serif;font-weight:600;letter-spacing:-.05em;line-height:1;color:var(--cream)}

  /* A — identity-led + ambient science */
  #vA{opacity:.28}
  .a-grad{background:radial-gradient(circle at 70% 45%, transparent 0%, rgba(48,44,46,.55) 55%, var(--ink) 80%)}
  .a-wrap{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:0 5vw 7vh;display:flex;flex-direction:column;gap:1.5rem;align-items:flex-start}
  .a-mono{font-size:2.4rem}

  /* B — signature molecular hero */
  #vB{opacity:.85}
  .b-grad{background:linear-gradient(to top, var(--hero-overlay) 0%, rgba(9,10,13,.35) 45%, transparent 75%)}
  .b-wrap{position:absolute;z-index:2;left:0;bottom:0;padding:0 5vw 8vh;display:flex;flex-direction:column;gap:1.6rem;align-items:flex-start}
  .b-label{position:absolute;z-index:2;right:5vw;bottom:8vh;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:color-mix(in srgb,var(--cream) 50%,transparent);text-align:right}

  /* C — pure typographic */
  .c-wrap{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.7rem;text-align:center}
  .c-mono{font-size:4.2rem}
  .c-rule{width:1px;height:54px;background:color-mix(in srgb,var(--cream) 40%,transparent)}
  .c-glow{position:absolute;inset:0;z-index:0;background:radial-gradient(circle at 50% 42%, rgba(201,130,78,.10), transparent 55%)}
</style>
</head>
<body>

<!-- A -->
<section class="hero">
  <span class="tag">A · identity-led + ambient science</span>
  <div id="vA" class="viewer"></div>
  <div class="grad a-grad"></div>
  <div class="a-wrap">
    <span class="a-mono mono">JF</span>
    <span class="eyebrow">Jorgensen Foundation · Est. 2026</span>
    <h1 class="display">The Shape<br>of <em>Discovery</em></h1>
    <a class="btn" href="#">Explore Our Programs</a>
  </div>
</section>

<!-- B -->
<section class="hero">
  <span class="tag">B · signature molecular hero</span>
  <div id="vB" class="viewer"></div>
  <div class="grad b-grad"></div>
  <div class="b-wrap">
    <span class="eyebrow">Jorgensen Foundation · Est. 2026</span>
    <h1 class="display">The Shape<br>of <em>Discovery</em></h1>
    <a class="btn" href="#">Explore Our Programs</a>
  </div>
  <div class="b-label">HIV-1 reverse transcriptase<br>Jorgensen-lab inhibitor · PDB 8U69</div>
</section>

<!-- C -->
<section class="hero">
  <span class="tag">C · pure typographic</span>
  <div class="c-glow"></div>
  <div class="c-wrap">
    <span class="c-mono mono">JF</span>
    <span class="eyebrow">Jorgensen Foundation · Est. 2026</span>
    <h1 class="display">The Shape of <em>Discovery</em></h1>
    <span class="c-rule"></span>
    <a class="btn" href="#">Explore Our Programs</a>
  </div>
</section>

<script src="https://3Dmol.org/build/3Dmol-min.js"></script>
<script>
(function(){
  if(!window.$3Dmol) return;
  var OYSTER=0xDEDCD5, CREAM=0xF4EFE4, AMBER=0xC9824E, SLATE=0x9AA0AE;

  function makeHero(id, opts){
    var el=document.getElementById(id);
    if(!el) return;
    var v=$3Dmol.createViewer(el,{backgroundColor:'#302C2E',backgroundAlpha:0});
    // Let drag-to-rotate work, but stop the wheel/two-finger gesture from being
    // hijacked for zoom: intercept it in the capture phase before 3Dmol's canvas
    // handler runs, and DON'T preventDefault — so the page scrolls normally.
    el.addEventListener('wheel', function(e){ e.stopPropagation(); }, { capture:true, passive:true });
    window.__hv = window.__hv || {}; window.__hv[id] = v;
    $3Dmol.download('pdb:8U69', v, {}, function(){
      v.setStyle({}, {});
      v.setStyle({hetflag:false}, {cartoon:{color: opts.protein}});
      if(opts.ligand){
        v.setStyle({hetflag:true}, {stick:{radius:0.18, color:AMBER}, sphere:{scale:0.28, color:AMBER}});
      }
      v.setStyle({resn:'HOH'}, {});
      v.zoomTo();
      v.zoom(opts.zoom||1.0, 600);
      v.render();
      var visible=true;
      if('IntersectionObserver' in window){
        new IntersectionObserver(function(e){visible=e[0].isIntersecting;},{threshold:0.02}).observe(el);
      }
      var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if(reduce){return;}
      function loop(){requestAnimationFrame(loop); if(!visible)return; v.rotate(opts.speed||0.12,{x:0,y:1,z:0}); v.render();}
      requestAnimationFrame(loop);
    });
  }

  makeHero('vA', {protein:OYSTER, ligand:false, zoom:0.85, speed:0.08});
  makeHero('vB', {protein:OYSTER, ligand:true, zoom:1.0, speed:0.14});
}());
</script>
</body>
</html>

<!-- LOGIN PAGE -->
<div class="page-wrap" id="page-login">
  <div class="card">
    <span class="card-label">Member Access</span>
    <h1 class="card-title">Sign in to<br><em>your account</em></h1>
    <p class="card-body">Access the Jorgensen Foundation's computational chemistry programs.</p>
    <div class="divider"></div>
    <div class="input-group">
      <label class="input-label" for="email">Email Address</label>
      <input class="input" type="email" id="email" placeholder="your@institution.edu">
    </div>
    <div class="input-group">
      <label class="input-label" for="password">Password</label>
      <div style="position:relative">
        <input class="input" type="password" id="password" placeholder="Your password" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()" style="padding-right:2.75rem">
        <button onclick="toggleVis('password', this)" class="eye-btn" type="button" aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
    </div>
    <p class="error-msg" id="login-error"></p>
    <button class="btn" id="login-btn" onclick="login()">Sign In</button>
    <span class="link-small">Don't have an account? <a href="/#access">Register here</a> · <a href="/reset-password">Forgot password?</a></span>
  </div>
</div>

<!-- PAYMENT PAGE -->
<div class="page-wrap hidden" id="page-payment">
  <div class="card">
    <span class="card-label" id="payment-label">Choose Your Plan</span>
    <h1 class="card-title">Activate your<br><em>account</em></h1>
    <p class="card-body" id="payment-body">Select a billing period to access the Jorgensen Foundation programs.</p>
    <div class="divider"></div>
    <span class="plan-type-label" id="plan-type-label"></span>
    <div class="plan-grid">
      <div class="plan-card selected" id="plan-monthly" onclick="selectPlan('monthly')">
        <div class="plan-period">Monthly</div>
        <div class="plan-price" id="price-monthly">$49<span>/mo</span></div>
        <div class="plan-save">Flexible</div>
      </div>
      <div class="plan-card" id="plan-annual" onclick="selectPlan('annual')">
        <div class="plan-period">Annual</div>
        <div class="plan-price" id="price-annual">$490<span>/yr</span></div>
        <div class="plan-save">Save 2 months</div>
      </div>
    </div>
    <p class="error-msg" id="payment-error"></p>
    <button class="btn" id="payment-btn" onclick="proceedToPayment()">Continue to Payment</button>
    <button class="access-code-toggle" onclick="toggleAccessCode()">Have an access code?</button>
    <div class="access-code-section" id="access-code-section">
      <div class="access-code-row">
        <input class="input" type="text" id="access-code-input" placeholder="Enter your access code">
        <button class="btn-apply" onclick="applyAccessCode()">Apply</button>
      </div>
      <p class="error-msg" id="code-error"></p>
      <p class="success-msg" id="code-success"></p>
    </div>
  </div>
</div>



<script src="/js/login.js"></script>

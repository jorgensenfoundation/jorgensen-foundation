---
layout: app.njk
title: Login — Jorgensen Foundation
navAuth: true
footerInclude: footer-app-full.njk
pageCss: /css/login.css
permalink: /login/index.html
---

<!-- LOGIN PAGE -->
<div class="page-wrap" id="page-login">
  <div class="card">
    <span class="card-label">Member Access</span>
    <h1 class="card-title">Sign in to<br><em>your account</em></h1>
    <p class="card-body">Access the Jorgensen Foundation's computational chemistry programs.</p>
    <div class="divider"></div>
    <div class="input-group">
      <label class="input-label" for="email">Email Address</label>
      <input class="input" type="email" id="email" placeholder="your@institution.edu">
    </div>
    <div class="input-group">
      <label class="input-label" for="password">Password</label>
      <div style="position:relative">
        <input class="input" type="password" id="password" placeholder="Your password" autocomplete="current-password" data-enter="login" style="padding-right:2.75rem">
        <button data-action="toggleVis" data-target="password" class="eye-btn" type="button" aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
    </div>
    <label class="login-remember"><input type="checkbox" id="login-remember"> Keep me signed in</label>
    <p class="error-msg" id="login-error"></p>
    <button class="btn" id="login-btn" data-action="login">Sign In</button>
    <div class="login-or"><span>or continue with</span></div>
    <div class="login-social">
      <button class="login-social-btn" type="button" data-action="oauthLogin" data-provider="google" aria-label="Continue with Google" title="Continue with Google">
        <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      </button>
      <button class="login-social-btn" type="button" data-action="oauthLogin" data-provider="github" aria-label="Continue with GitHub" title="Continue with GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </button>
    </div>
    <span class="link-small">Don't have an account? <a href="/#access">Register here</a> · <a href="/reset-password">Forgot password?</a></span>
  </div>
</div>

<!-- PAYMENT PAGE -->
<div class="page-wrap hidden" id="page-payment">
  <div class="card">
    <span class="card-label" id="payment-label">Choose Your Plan</span>
    <h1 class="card-title">Activate your<br><em>account</em></h1>
    <p class="card-body" id="payment-body">Select a billing period to access the Jorgensen Foundation programs.</p>
    <div class="divider"></div>
    <span class="plan-type-label" id="plan-type-label"></span>
    <div class="plan-grid">
      <div class="plan-card selected" id="plan-monthly" data-action="selectPlan" data-period="monthly">
        <div class="plan-period">Monthly</div>
        <div class="plan-price" id="price-monthly">$199<span>/mo</span></div>
        <div class="plan-save">Flexible</div>
      </div>
      <div class="plan-card" id="plan-annual" data-action="selectPlan" data-period="annual">
        <div class="plan-period">Annual</div>
        <div class="plan-price" id="price-annual">$1,990<span>/yr</span></div>
        <div class="plan-save">Save 2 months</div>
      </div>
    </div>
    <p class="error-msg" id="payment-error"></p>
    <button class="btn" id="payment-btn" data-action="proceedToPayment">Continue to Payment</button>
  </div>
</div>



<script src="/js/login.js?v={{ buildId }}"></script>

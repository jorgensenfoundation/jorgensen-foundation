<!DOCTYPE html>
<html lang="en">
<head>
{% if comingSoonGate != false %}<script>if(sessionStorage.getItem('jf_access')!=='true'){window.location.replace('/coming-soon');}</script>{% endif %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Always render in light appearance, regardless of the device's Dark Mode, so
     colours look identical on iPad, iPhone and Mac (no UA dark-mode tinting). -->
<meta name="color-scheme" content="light">
<title>{{ title or site.name }}</title>
{% include "seo.njk" %}
<link rel="icon" href="/img/favicon.svg?v=4" type="image/svg+xml">
<link rel="icon" href="/img/favicon-32.png?v=4" sizes="32x32" type="image/png">
<link rel="icon" href="/img/favicon-16.png?v=4" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v=4">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ mainCss or '/css/style.css' }}">
{% if navCss %}<link rel="stylesheet" href="/css/nav.css">{% endif %}
{% if supportWidget != false %}<link rel="stylesheet" href="/css/support.css">{% endif %}
{% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
<script src="/js/auth.js"></script>
</head>
<body>

{{ content | safe }}

{% set _footer = footerInclude or "footer.njk" %}{% include _footer %}

{% if mainJs != false %}<script src="/js/main.js"></script>{% endif %}
{% if navCss %}<script src="/js/search.js" defer></script>{% endif %}
{% if supportWidget != false %}{% include "support-widget.njk" %}<script src="/js/support.js" defer></script>{% endif %}
<script src="/js/reveal.js"></script>
</body>
</html>

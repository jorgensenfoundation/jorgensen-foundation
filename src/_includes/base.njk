<!DOCTYPE html>
<html lang="en">
<head>
{% if comingSoonGate != false %}<script>if(sessionStorage.getItem('jf_access')!=='true'){window.location.replace('/coming-soon');}</script>{% endif %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ mainCss or '/css/style.css' }}">
{% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
<script src="/js/auth.js"></script>
</head>
<body>

{{ content | safe }}

{% set _footer = footerInclude or "footer.njk" %}{% include _footer %}

{% if mainJs != false %}<script src="/js/main.js"></script>{% endif %}
</body>
</html>

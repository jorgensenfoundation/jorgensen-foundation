<!DOCTYPE html>
<html lang="en">
<head>
{% if comingSoonGate != false %}<script src="/js/gate.js?v={{ buildId }}"></script>{% endif %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Always render in light appearance, regardless of the device's Dark Mode, so
     colours look identical on iPad, iPhone and Mac (no UA dark-mode tinting). -->
<meta name="color-scheme" content="light">
<title>{{ title or site.name }}</title>
{% include "seo.njk" %}
<link rel="icon" href="/img/favicon.svg?v=6" type="image/svg+xml">
<link rel="icon" href="/img/favicon-32.png?v=6" sizes="32x32" type="image/png">
<link rel="icon" href="/img/favicon-16.png?v=6" sizes="16x16" type="image/png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v=6">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ mainCss or '/css/style.css' }}?v={{ buildId }}">
{% if navCss %}<link rel="stylesheet" href="/css/nav.css?v={{ buildId }}">{% endif %}
{% if supportWidget != false %}<link rel="stylesheet" href="/css/support.css?v={{ buildId }}">{% endif %}
{% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}?v={{ buildId }}">{% endif %}
<script src="/js/config.js?v={{ buildId }}"></script>
<script src="/js/actions.js?v={{ buildId }}"></script>
<script src="/js/auth.js?v={{ buildId }}"></script>
</head>
<body>

{{ content | safe }}

{% set _footer = footerInclude or "footer.njk" %}{% include _footer %}

{% if mainJs != false %}<script src="/js/main.js?v={{ buildId }}"></script>{% endif %}
{% if navCss %}<script src="/js/search.js?v={{ buildId }}" defer></script>{% endif %}
{% if supportWidget != false %}{% include "support-widget.njk" %}<script src="/js/support.js?v={{ buildId }}" defer></script>{% endif %}
<script src="/js/reveal.js?v={{ buildId }}"></script>
<script src="/js/analytics.js?v={{ buildId }}" defer></script>
</body>
</html>

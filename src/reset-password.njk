---
layout: app.njk
title: Reset Password — Jorgensen Foundation
pageCss: /css/reset-password.css
permalink: /reset-password/index.html
comingSoonGate: false
---

<main>
  <div class="card">

    <!-- REQUEST RESET -->
    <div class="state active" id="state-request">
      <span class="card-label">Account Recovery</span>
      <h1 class="card-title">Reset your<br><em>password</em></h1>
      <p class="card-body">Enter your email address and we'll send you a link to reset your password.</p>
      <div class="divider"></div>
      <div class="input-group">
        <label class="input-label" for="reset-email">Email Address</label>
        <input class="input" type="email" id="reset-email" placeholder="your@email.com" onkeydown="if(event.key==='Enter')requestReset()">
      </div>
      <p class="error-msg" id="request-error"></p>
      <button class="btn" id="request-btn" onclick="requestReset()">Send Reset Link</button>
      <a href="/login" class="btn-outline">Back to Sign In</a>
    </div>

    <!-- EMAIL SENT -->
    <div class="state" id="state-sent">
      <span class="card-label">Check your inbox</span>
      <h1 class="card-title">Email<br><em>sent</em></h1>
      <p class="card-body">If an account exists for that email address, you will receive a password reset link shortly. Check your spam folder if you don't see it.</p>
      <div class="divider"></div>
      <a href="/login" class="btn">Return to Sign In</a>
    </div>

    <!-- SET NEW PASSWORD -->
    <div class="state" id="state-reset">
      <span class="card-label">Account Recovery</span>
      <h1 class="card-title">Create new<br><em>password</em></h1>
      <p class="card-body">Choose a new password for your account.</p>
      <div class="divider"></div>
      <div class="input-group">
        <label class="input-label" for="new-password">New Password</label>
        <div style="position:relative">
          <input class="input" type="password" id="new-password" placeholder="Minimum 8 characters" autocomplete="new-password" style="padding-right:2.75rem">
          <button onclick="toggleVis('new-password', this)" class="eye-btn" type="button" aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
      </div>

      <p class="error-msg" id="reset-error"></p>
      <button class="btn" id="reset-btn" onclick="resetPassword()">Set New Password</button>
    </div>

    <!-- SUCCESS -->
    <div class="state" id="state-success">
      <span class="card-label">Password Updated</span>
      <h1 class="card-title">All done.<br><em>Sign in.</em></h1>
      <p class="card-body">Your password has been updated successfully. You can now sign in with your new password.</p>
      <div class="divider"></div>
      <a href="/login" class="btn">Sign In</a>
    </div>

    <!-- ERROR -->
    <div class="state" id="state-error">
      <span class="card-label">Link Expired</span>
      <h1 class="card-title">Invalid<br><em>link</em></h1>
      <p class="card-body">This reset link is invalid or has already been used. Please request a new one.</p>
      <div class="divider"></div>
      <button class="btn" onclick="showState('state-request')">Request New Link</button>
    </div>

  </div>
</main>


<script src="/js/reset-password.js"></script>

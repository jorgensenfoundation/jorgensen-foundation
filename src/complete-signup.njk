<!-- SOCIAL SIGN-IN ONBOARDING — reached when a provider authenticated a brand-new
     user. The backend redirects here with a signed #pending=… blob. We collect the
     institution (always required) and an email (only when the provider withheld a
     verified one), then call /auth/complete-signup to create the account. -->
<div class="page-wrap" id="page-complete">
  <div class="card">
    <span class="card-label">Member Access</span>
    <h1 class="card-title">Almost<br><em>there</em></h1>
    <p class="card-body">Just one more detail to finish setting up your Jorgensen Foundation account.</p>
    <div class="divider"></div>

    <div class="input-group" id="email-group" style="display:none">
      <label class="input-label" for="cs-email">Email Address</label>
      <input class="input" type="email" id="cs-email" placeholder="your@institution.edu" autocomplete="email">
    </div>

    <div class="input-group">
      <label class="input-label" for="cs-institution">Institution</label>
      <input class="input" type="text" id="cs-institution" placeholder="Your university or company" autocomplete="organization" onkeydown="if(event.key==='Enter')completeSignup()">
    </div>

    <p class="error-msg" id="cs-error"></p>
    <button class="btn" id="cs-btn" onclick="completeSignup()">Create Account</button>
    <span class="link-small">Already have an account? <a href="/login">Sign in</a></span>
  </div>
</div>

<script src="/js/complete-signup.js"></script>

---
layout: base.njk
title: Admin — Jorgensen Foundation
comingSoonGate: false
mainCss: /css/admin.css
navCss: true
footerInclude: footer-none.njk
mainJs: false
permalink: /admin/index.html
---

<style>
  /* Hover tint for the admin nav links (was inline onmouseover/onmouseout). */
  .nav--admin .admin-navlink { color: rgba(245,240,230,0.35); transition: color 0.2s; }
  .nav--admin .admin-navlink:hover { color: rgba(245,240,230,0.7); }
</style>
<nav class="nav--admin">
  <a href="/" class="nav-logo">Jorgensen Foundation</a>
  <span class="nav-tag">Admin</span>
  <div style="display:flex;align-items:center;gap:1.5rem">
    <a href="/about" class="admin-navlink" style="font-size:0.52rem;letter-spacing:0.22em;text-transform:uppercase">About</a>
    <a href="/publications" class="admin-navlink" style="font-size:0.52rem;letter-spacing:0.22em;text-transform:uppercase">Publications</a>
    <a href="/news" class="admin-navlink" style="font-size:0.52rem;letter-spacing:0.22em;text-transform:uppercase">News</a>
    <a href="/contact" class="admin-navlink" style="font-size:0.52rem;letter-spacing:0.22em;text-transform:uppercase">Contact</a>
    <button class="nav-logout" id="nav-logout" data-action="logout">Sign Out</button>
  </div>
</nav>

<!-- LOGIN -->
<div class="login-wrap" id="login-wrap">
  <div class="card">
    <span class="card-label">Restricted Access</span>
    <h1 class="card-title">Admin<br><em>Dashboard</em></h1>
    <div class="divider"></div>
    <label class="input-label">Admin Password</label>
    <div style="position:relative">
      <input class="input" type="password" id="admin-password" placeholder="Enter admin password" data-enter="adminLogin" style="padding-right:2rem">
      <button data-action="togglePasswordVisibility" style="position:absolute;right:0;bottom:0.75rem;background:none;border:none;cursor:pointer;color:#bbb;font-size:0.75rem;font-family:Helvetica,Arial,sans-serif;letter-spacing:0.05em" type="button" id="admin-show-btn">SHOW</button>
    </div>
    <p class="error-msg" id="login-error"></p>
    <button class="btn" id="login-btn" data-action="adminLogin">Sign In</button>
  </div>
</div>

<!-- DASHBOARD -->
<div class="admin-dashboard" id="admin-dashboard">
 <div class="admin-shell">
  <aside class="admin-rail" id="admin-rail">
    <button class="rail-item" data-section="overview" data-action="showSection" type="button">
      <span class="rail-label">Overview</span>
    </button>
    <button class="rail-item" data-section="support" data-action="showSection" type="button">
      <span class="rail-label">Support</span><span class="rail-count" id="rail-count-support"></span>
    </button>
    <button class="rail-item" data-section="grants" data-action="showSection" type="button">
      <span class="rail-label">Grants</span><span class="rail-count" id="rail-count-grants"></span>
    </button>
    <button class="rail-item" data-section="users" data-action="showSection" type="button">
      <span class="rail-label">Users</span><span class="rail-count" id="rail-count-users"></span>
    </button>
    <button class="rail-item" data-section="board" data-action="showSection" type="button">
      <span class="rail-label">Board</span>
    </button>
    <button class="rail-item" data-section="newsletter" data-action="showSection" type="button">
      <span class="rail-label">Newsletter</span>
    </button>
  </aside>

  <div class="admin-main">

    <!-- OVERVIEW -->
    <section class="admin-section" id="section-overview">
      <div class="section-head"><div class="table-title">Overview</div></div>
      <div class="overview-attention" id="overview-attention"></div>
      <div class="stats-row">
        <div class="stat-box"><div class="stat-num" id="stat-total">—</div><div class="stat-label">Total Users</div></div>
        <div class="stat-box"><div class="stat-num" id="stat-active">—</div><div class="stat-label">Active Subscriptions</div></div>
        <div class="stat-box"><div class="stat-num" id="stat-academia">—</div><div class="stat-label">Academia</div></div>
        <div class="stat-box"><div class="stat-num" id="stat-industry">—</div><div class="stat-label">Industry</div></div>
        <div class="stat-box"><div class="stat-num" id="stat-grants">—</div><div class="stat-label">Grant Applications</div></div>
        <div class="stat-box"><div class="stat-num" id="stat-newsletter">—</div><div class="stat-label">Newsletter Subscribers</div></div>
      </div>
    </section>

    <!-- SUPPORT -->
    <section class="admin-section" id="section-support">
      <div class="table-header">
        <div class="table-title">Support Tickets</div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <div class="filter-row" id="support-filters">
            <button class="filter-btn active" data-action="setSupportFilter" data-status="">All</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="needs_review">Needs review</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="approved">Approved</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="hold">Hold</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="fixed">Fixed</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="closed">Closed</button>
            <button class="filter-btn" data-action="setSupportFilter" data-status="deleted">Deleted</button>
          </div>
          <button class="refresh-btn" data-action="loadSupport">Refresh</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Status</th><th>Severity</th><th>Category</th><th>Summary</th><th>From</th><th>Updated</th><th></th></tr>
          </thead>
          <tbody id="support-table">
            <tr><td colspan="7" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- GRANTS -->
    <section class="admin-section" id="section-grants">
      <div class="table-header">
        <div class="table-title">Grant Applications</div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <input class="search-input" type="text" id="grants-search" placeholder="Search name, email, conference...">
          <button class="refresh-btn" data-action="loadGrants">Refresh</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Applicant</th><th>Institution</th><th>Supervisor</th><th>Amount</th><th>Status</th><th>Next Action</th><th></th></tr>
          </thead>
          <tbody id="grants-table">
            <tr><td colspan="7" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="show-more-wrap" id="grants-more"></div>
    </section>

    <!-- USERS -->
    <section class="admin-section" id="section-users">
      <div class="table-header">
        <div class="table-title">All Users</div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <input class="search-input" type="text" id="search" placeholder="Search email or name...">
          <div class="filter-row">
            <button class="filter-btn active" data-action="setFilter" data-filter="all">All</button>
            <button class="filter-btn" data-action="setFilter" data-filter="academia">Academia</button>
            <button class="filter-btn" data-action="setFilter" data-filter="industry">Industry</button>
            <button class="filter-btn" data-action="setFilter" data-filter="active">Active</button>
            <button class="filter-btn" data-action="setFilter" data-filter="inactive">Inactive</button>
          </div>
          <button class="refresh-btn" data-action="loadUsers">Refresh</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Institution</th><th>Type</th><th>Verified</th><th>Subscription</th><th>Last login</th><th>Registered</th><th>Actions</th></tr>
          </thead>
          <tbody id="users-table">
            <tr><td colspan="9" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="show-more-wrap" id="users-more"></div>
    </section>

    <!-- BOARD -->
    <section class="admin-section" id="section-board">
      <div class="table-header">
        <div class="table-title">Board Members</div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <input class="search-input" type="email" id="board-email" placeholder="board.member@institution.edu">
          <button class="refresh-btn" data-action="inviteBoardMember">Add</button>
        </div>
      </div>
      <p class="board-msg" id="board-msg"></p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Email</th><th>First Name</th><th>Last Name</th><th>Actions</th></tr>
          </thead>
          <tbody id="board-members-table">
            <tr><td colspan="4" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="show-more-wrap" id="board-more"></div>
    </section>

    <!-- NEWSLETTER -->
    <section class="admin-section" id="section-newsletter">
      <div class="table-header">
        <div class="table-title">Newsletter Subscribers</div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
          <input class="search-input" type="text" id="newsletter-search" placeholder="Search email...">
          <button class="refresh-btn" data-action="loadNewsletter">Refresh</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>#</th><th>Email</th><th>Subscribed</th></tr>
          </thead>
          <tbody id="newsletter-table">
            <tr><td colspan="3" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="show-more-wrap" id="newsletter-more"></div>
    </section>

  </div>
 </div>
</div>

<footer>
  <div class="footer-bottom">
    <span class="footer-copy">© 2026 Jorgensen Foundation · Admin Panel</span>
    <div class="footer-legal">
      <a href="/terms">Terms of Service</a>
      <a href="/privacy">Privacy Policy</a>
      <span class="footer-copy">info@jorgensenfoundation.org</span>
    </div>
  </div>
</footer>


<script src="/js/admin.js?v={{ buildId }}"></script>
